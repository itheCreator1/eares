# Copy to .env and change every password before first `docker compose up`.

# --- Database -------------------------------------------------------------
DB_NAME=eares
DB_USER=eares
DB_PASSWORD=change-me-db
DB_ROOT_PASSWORD=change-me-root
DB_TABLE_PREFIX=wp_

# --- Ports (bound to 127.0.0.1 only) --------------------------------------
WP_PORT=8080
MAILPIT_PORT=8025
ADMINER_PORT=8081

# --- WordPress install (used by scripts/setup.sh) -------------------------
WP_URL=http://localhost:8080
WP_TITLE=ΕΑΡΕΣ
WP_TAGLINE="Ένωση Αποφοίτων Ριζαρείου Εκκλησιαστικής Σχολής"
WP_ADMIN_USER=admin
WP_ADMIN_EMAIL=admin@eares.local
WP_ADMIN_PASSWORD=change-me-admin
# Optional second Administrator (leave empty to skip).
WP_BACKUP_ADMIN_USER=
WP_BACKUP_ADMIN_EMAIL=
WP_BACKUP_ADMIN_PASSWORD=
WP_DEBUG=0
# local | staging | production (seed-users.sh refuses to run in production;
# setup.sh refuses the change-me passwords anywhere but local)
WP_ENVIRONMENT_TYPE=local
# Search engines: empty lets setup.sh decide (local/staging always hidden; a
# production site starts hidden, then Settings > Reading is the owner's and
# re-runs never touch it). 1 = visible, 0 = hidden, enforced on every run.
BLOG_PUBLIC=

# --- Reverse proxy / HTTPS ------------------------------------------------
# 1 only when a reverse proxy you control sits in front of WordPress: it makes
# WordPress honour X-Forwarded-Proto and take the visitor IP (used by the
# login limit) from X-Forwarded-For. Leave 0 when the site is reached directly,
# or anyone could fake their IP.
TRUST_PROXY=0
# 1 once the site is served over HTTPS: wp-admin and logins then require it.
FORCE_SSL_ADMIN=0

# --- Production (docker-compose.prod.yml) --------------------------------
# On the server only: uncomment all three. COMPOSE_FILE makes every
# `docker compose` command and script use the production override (Caddy with
# HTTPS on ports 80/443, no Mailpit). Set WP_URL=https://<SITE_DOMAIN> too.
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
# SITE_DOMAIN=eares.gr
# ACME_EMAIL=admin@eares.gr

# --- Outgoing mail --------------------------------------------------------
# Local dev: Mailpit catches everything. In production point these at a real
# SMTP provider — the emailed 2FA code depends on reliable delivery.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
# "", "tls" or "ssl"
SMTP_SECURE=
MAIL_FROM=noreply@eares.local
MAIL_FROM_NAME=ΕΑΡΕΣ

# --- Backups (scripts/backup.sh) -----------------------------------------
# Days to keep backup sets in ./backups/ and at BACKUP_REMOTE.
BACKUP_KEEP_DAYS=14
BACKUP_REMOTE_KEEP_DAYS=90
# Off-site copy, as an rclone remote:path defined in ./rclone/rclone.conf, e.g.
# eares-offsite:  (an encrypting "crypt" remote over S3, B2, SFTP...). Empty =
# no off-site copy, which is fine on a laptop and nowhere else.
BACKUP_REMOTE=
# Optional: a URL pinged after every successful backup (healthchecks.io or
# similar), so you hear about it when backups stop.
BACKUP_PING_URL=

# --- Test users (scripts/seed-users.sh) -----------------------------------
SEED_PASSWORD=Test-Pass-2026!
