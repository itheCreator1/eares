# Exact WordPress core and plugin versions this site runs. setup.sh and
# update.sh install these and nothing newer, so every server and every CI run
# builds the same site. To update: scripts/update.sh --check lists newer
# releases; bump the numbers here in a pull request, let CI test them, merge,
# then run scripts/update.sh on the server.
#
# Sourced by scripts/lib.sh. Keep to plain KEY=value lines.

WP_CORE_VERSION=7.1.4

# slug@version, space-separated. Every plugin listed is installed and activated.
WP_PLUGINS="two-factor@0.17.0 simple-history@5.34.0"
